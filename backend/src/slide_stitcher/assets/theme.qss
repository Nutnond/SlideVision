/* SlideVision dark theme */

QWidget {
    background: #0f172a;
    color: #f1f5f9;
    font-family: "SF Pro Text", "Helvetica Neue", system-ui, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background: #0b1224;
}

/* ===== Menu bar ===== */
QMenuBar {
    background: #131c31;
    border-bottom: 1px solid #1e293b;
    padding: 4px 8px;
    spacing: 4px;
    color: #cbd5e1;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
    color: #cbd5e1;
}
QMenuBar::item:selected {
    background: #1e1b4b;
    color: #a5b4fc;
}
QMenuBar::item:pressed {
    background: #312e81;
    color: #ffffff;
}

QMenu {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
    color: #e2e8f0;
}
QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
    color: #cbd5e1;
}
QMenu::item:selected {
    background: #4f46e5;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #334155;
    margin: 4px 8px;
}

/* ===== Status bar ===== */
QStatusBar {
    background: #131c31;
    border-top: 1px solid #1e293b;
    color: #94a3b8;
    padding: 2px 8px;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #cbd5e1;
}

/* ===== Sidebar (CaseSidebar) ===== */
QListWidget {
    background: #131c31;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 6px;
    outline: 0;
    color: #e2e8f0;
}
QListWidget::item {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    margin: 3px;
    color: #e2e8f0;
}
QListWidget::item:hover {
    background: #1e1b4b;
    border-color: #4f46e5;
}
QListWidget::item:selected {
    background: #4f46e5;
    border-color: #6366f1;
    color: #ffffff;
}

/* ===== Buttons ===== */
QPushButton {
    background: #4f46e5;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 500;
}
QPushButton:hover {
    background: #6366f1;
}
QPushButton:pressed {
    background: #4338ca;
}
QPushButton:disabled {
    background: #1e293b;
    color: #475569;
}

/* ===== Splitters ===== */
QSplitter::handle {
    background: #1e293b;
}
QSplitter::handle:horizontal {
    width: 1px;
}

/* ===== Scroll bars ===== */
QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== Dialogs ===== */
QDialog {
    background: #131c31;
    color: #f1f5f9;
}
QLabel {
    background: transparent;
    color: #e2e8f0;
}
QLineEdit {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f1f5f9;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1px solid #6366f1;
}

/* ===== Tool buttons ===== */
QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    color: #cbd5e1;
}
QToolButton:hover {
    background: #1e1b4b;
    color: #a5b4fc;
}
QToolButton:pressed,
QToolButton:checked {
    background: #312e81;
    color: #ffffff;
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #334155;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #6366f1;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #6366f1;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #e0e7ff;
}

/* ===== QMessageBox ===== */
QMessageBox {
    background: #131c31;
}
QMessageBox QLabel {
    color: #e2e8f0;
}

/* ===== QInputDialog combobox ===== */
QComboBox {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f1f5f9;
}
QComboBox:hover {
    border-color: #4f46e5;
}
QComboBox QAbstractItemView {
    background: #1e293b;
    border: 1px solid #334155;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
    color: #e2e8f0;
    outline: 0;
}

/* ===== Welcome screen CaseCards ===== */
QFrame#CaseCard {
    background: #131c31;
    border: 1px solid #1e293b;
    border-radius: 10px;
}
QFrame#CaseCard:hover {
    background: #1e1b4b;
    border: 1px solid #4f46e5;
}
QWidget#WelcomeScreen {
    background: #0b1224;
}
QScrollArea {
    background: transparent;
    border: none;
}
